PORT=3000
NODE_ENV=development

# Use either DATABASE_URL for direct PostgreSQL access, or Supabase values below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI keys are intentionally optional. Backend falls back to mock AI when absent.
# LLM_PROVIDER can be: openrouter, openai, or empty for mock fallback.
LLM_PROVIDER=openrouter
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Local Food Matchmaker
EMBEDDING_API_KEY=
EMBEDDING_SERVICE_URL=http://localhost:8001

# Backend-only key for route distance / travel time calculations in later phases.
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=
# TRANSPORT_DISTANCE_PROVIDER can be: google, serpapi, or empty for PostGIS-only distance.
TRANSPORT_DISTANCE_PROVIDER=serpapi
