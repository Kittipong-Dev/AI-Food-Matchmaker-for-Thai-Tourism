PORT=3000
NODE_ENV=development

# Use either DATABASE_URL for direct PostgreSQL access, or Supabase values below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI keys are intentionally optional for early phases.
LLM_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_SERVICE_URL=http://localhost:8001

# Backend-only key for route distance / travel time calculations in later phases.
GOOGLE_MAPS_API_KEY=
TRANSPORT_DISTANCE_PROVIDER=google
